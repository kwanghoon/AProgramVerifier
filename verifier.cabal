cabal-version:      2.4
name:               simple-verifier
version:            0.1.0.0
build-type:         Simple

library
  exposed-modules:     Verifier
  hs-source-dirs:      src
  build-depends:       base >=4.14 && <5, containers
  default-language:    Haskell2010
  ghc-options:         -Wall

executable verifier
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:       base >=4.14 && <5, simple-verifier
  default-language:    Haskell2010
  ghc-options:         -Wall

test-suite verifier-tests
  type:                exitcode-stdio-1.0
  main-is:             Spec.hs
  hs-source-dirs:      test
  build-depends:       base >=4.14 && <5, simple-verifier
  default-language:    Haskell2010
  ghc-options:         -Wall
